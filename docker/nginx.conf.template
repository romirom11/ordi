# Rendered by the official nginx image's envsubst entrypoint: ${API_UPSTREAM}
# is replaced at container start (default api:3000, see Dockerfile.web), and
# everything else - nginx's own $variables - passes through untouched because
# only *defined environment variables* are substituted.
#
# API_UPSTREAM exists because service names differ per platform: `api` in our
# compose files, `ordi-api` or similar on Dokploy/Coolify. Set the env var
# instead of replacing this file - a replaced file is frozen at the day it was
# written and silently misses every route added later (that is precisely how
# instances end up with MCP clients unable to connect: /.well-known/ must
# reach the API, and hand-written configs never say so).

# Honour an outer proxy's X-Forwarded-Proto (TLS is usually terminated above
# this container, so $scheme alone would say "http" on an https site).
map $http_x_forwarded_proto $fwd_proto {
  default $scheme;
  "~."    $http_x_forwarded_proto;
}

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # SPA fallback
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Health endpoints belong to the API, not the SPA fallback
  location = /healthz {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
  }
  location = /readyz {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
  }

  # OAuth discovery for MCP clients (RFC 8414/9728) is served by the API.
  # The path is fixed by the RFCs and read at the *root* of the domain -
  # clients derive it from the issuer, we cannot move it under /api/.
  # Host and proto must pass through: the API answers with absolute URLs.
  location /.well-known/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  # Proxy API to the api service
  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    # SSE
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
  }
}
