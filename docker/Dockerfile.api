# ordi API image (Node 22 LTS). Runs migrations then the API + workers.
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

# Install deps (workspace-aware)
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile=false --filter @ordi/api...

# Copy sources
COPY packages/shared packages/shared
COPY packages/db packages/db
COPY apps/api apps/api

ENV NODE_ENV=production
EXPOSE 3000

# Entrypoint: run migrations (additive, separate step) then start server+workers.
CMD ["sh", "-c", "pnpm --filter @ordi/db migrate && pnpm --filter @ordi/api exec tsx src/server.ts"]
