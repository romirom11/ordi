# ordi image (Node 22 LTS): the whole application in one container.
# Runs migrations, then the API + workers, and serves the built SPA itself -
# point your domain at this container's port 3000 and you are done. No nginx,
# no cross-container routing to configure, and the OAuth discovery paths MCP
# clients need (/.well-known/*) are just routes on the same server.

# ── SPA build stage ──
FROM node:22-slim AS webbuild
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile=false --filter @ordi/web...
COPY packages/shared packages/shared
COPY apps/web apps/web
RUN pnpm --filter @ordi/web build
# Precompress text assets once at build time; the server picks the .gz up via
# Accept-Encoding (serveStatic precompressed) instead of compressing per request.
RUN find apps/web/dist -type f \( -name '*.js' -o -name '*.css' -o -name '*.html' -o -name '*.svg' -o -name '*.json' -o -name '*.txt' -o -name '*.map' \) -exec gzip -k -9 {} +

# ── API stage ──
FROM node:22-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
# git is a runtime dependency, not a build tool: the agent worker clones the
# project's repository per run and pushes the agent's branch back (plan R15,
# R26). ca-certificates comes with it so those https clones can verify GitHub.
RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app

# Install deps (workspace-aware). Every workspace package the API depends on
# must appear BOTH here and in the source COPY below – a missing one is not a
# build error, it is a crash on boot (ERR_MODULE_NOT_FOUND), which is exactly
# how @ordi/mcp slipped through once. CI now boots this image to catch that.
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY packages/mcp/package.json packages/mcp/
COPY apps/api/package.json apps/api/
RUN pnpm install --frozen-lockfile=false --filter @ordi/api...

# The Claude runtime the agent worker drives ships as an OPTIONAL platform
# dependency of @anthropic-ai/claude-agent-sdk (…-linux-x64 / …-linux-arm64),
# so a well-meaning --no-optional here would build an image that installs
# cleanly and then fails at the first agent run. Fail the build instead:
# import the SDK the way the adapter does and resolve the binary it spawns.
WORKDIR /app/apps/api
RUN node --input-type=module -e "\
import { createRequire } from 'node:module'; \
const sdk = await import('@anthropic-ai/claude-agent-sdk'); \
if (typeof sdk.query !== 'function') throw new Error('claude-agent-sdk did not export query()'); \
const require = createRequire(import.meta.resolve('@anthropic-ai/claude-agent-sdk')); \
const bin = require.resolve('@anthropic-ai/claude-agent-sdk-' + process.platform + '-' + process.arch + '/claude'); \
console.log('claude runtime: ' + bin);"
WORKDIR /app

# Per-run checkouts live here (AGENT_WORK_DIR): the worker clones into
# /data/agent-work/<runId> and deletes the directory when the run ends. Both
# compose files mount a named volume on it – no VOLUME instruction here, or
# every `docker run` of this image would leave an anonymous volume behind.
RUN mkdir -p /data/agent-work

# Copy sources
COPY packages/shared packages/shared
COPY packages/db packages/db
COPY packages/mcp packages/mcp
COPY apps/api apps/api

# The built SPA, served by the API itself (apps/api/src/web.ts finds it at
# ../web/dist relative to its cwd; override with WEB_DIST).
COPY --from=webbuild /app/apps/web/dist apps/web/dist

ENV NODE_ENV=production
EXPOSE 3000

# Entrypoint: run migrations (additive, separate step) then start server+workers.
CMD ["sh", "-c", "pnpm --filter @ordi/db migrate && pnpm --filter @ordi/api exec tsx src/server.ts"]
