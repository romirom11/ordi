# DEPRECATED since v1.6.0: the API image serves the SPA itself - one
# container is the whole application, point your domain at api:3000.
# This nginx image keeps working for existing deployments that pin it,
# and will be removed in a future release.
# ordi web image: build the SPA, serve static with nginx.
FROM node:22-slim AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* .npmrc tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile=false --filter @ordi/web...

COPY packages/shared packages/shared
COPY apps/web apps/web
RUN pnpm --filter @ordi/web build

FROM nginx:1.27-alpine
# Where the API lives on the container network. Our compose files call the
# service `api`; on Dokploy/Coolify set API_UPSTREAM (e.g. ordi-api:3000)
# instead of replacing the config file - the template in /etc/nginx/templates
# is rendered on every start by the image's stock envsubst entrypoint, so the
# routes (incl. /.well-known/ for MCP OAuth discovery) track releases.
ENV API_UPSTREAM=api:3000
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
