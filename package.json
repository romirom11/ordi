{
  "name": "ordi",
  "version": "1.0.2",
  "private": true,
  "description": "ordi – agency operations platform (CRM, Projects, KB, Time, Finance, People)",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:query-shapes": "node scripts/check-query-shapes.mjs",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ordi/db generate",
    "db:migrate": "pnpm --filter @ordi/db migrate",
    "db:seed": "pnpm --filter @ordi/api seed",
    "api:dev": "pnpm --filter @ordi/api dev",
    "web:dev": "pnpm --filter @ordi/web dev"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
