{
  "name": "ordi",
  "version": "1.26.0",
  "private": true,
  "description": "The operations system for small agencies and product teams: projects, CRM, knowledge base, time, finance and people in one self-hosted app.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/romirom11/ordi",
  "repository": {
    "type": "git",
    "url": "https://github.com/romirom11/ordi.git"
  },
  "bugs": {
    "url": "https://github.com/romirom11/ordi/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:query-shapes": "node scripts/check-query-shapes.mjs",
    "site:build": "node scripts/build-site.mjs",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @ordi/db generate",
    "db:migrate": "pnpm --filter @ordi/db migrate",
    "db:seed": "pnpm --filter @ordi/api seed",
    "api:dev": "pnpm --filter @ordi/api dev",
    "web:dev": "pnpm --filter @ordi/web dev",
    "check:desktop-safe": "node scripts/check-desktop-safe.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
